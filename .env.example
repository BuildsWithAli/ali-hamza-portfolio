# ---------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# On Vercel: Project Settings -> Environment Variables -> add each one there
# (see README.md for the full step-by-step).
# ---------------------------------------------------------------------------

# --- Supabase (free tier: https://supabase.com) ---------------------------
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key -- server-side ONLY, never exposed to the browser.
# Same page, further down ("service_role" secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Outgoing email for the contact form (Gmail example) ------------------
# Use a Gmail "App Password", NOT your normal Gmail password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on)
EMAIL_USER=alirana0405@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password
# Where contact-form messages get emailed. Defaults to EMAIL_USER if unset.
ADMIN_EMAIL=alirana0405@gmail.com

# --- Admin dashboard (/admin) ----------------------------------------------
# Password to log into /admin. Pick your own.
ADMIN_PASSWORD=change-me
# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-too
